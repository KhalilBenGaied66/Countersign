# Copy to .env. Every value below is the default; uncomment what you change.
# The full list is in docs/operations.md.

# --- Models (a local Ollama server) ---------------------------------------------
# COUNTERSIGN_OLLAMA_URL=http://127.0.0.1:11434
# COUNTERSIGN_SMALL_MODEL=qwen3.5:4b
# COUNTERSIGN_LARGE_MODEL=qwen3.5:9b
# COUNTERSIGN_MODEL_TIMEOUT_S=240
# Tries after the first one when the model server answers an error:
# COUNTERSIGN_MODEL_RETRIES=2

# Answer from the recordings of the evaluation instead of a model server (no GPU).
# `countersign demo` sets both of these and queues the samples:
# COUNTERSIGN_REPLAY_DIR=evals/cassettes/test
# The date the checks take for today (the recorded samples are dated mid-2026):
# COUNTERSIGN_TODAY=2026-07-01

# --- Storage ---------------------------------------------------------------------
# COUNTERSIGN_DATABASE_URL=sqlite:///var/countersign.db
# COUNTERSIGN_STORAGE_DIR=var/documents
# COUNTERSIGN_EXPORT_DIR=var/export
# COUNTERSIGN_REFERENCE_DIR=data/reference

# --- Queue -----------------------------------------------------------------------
# COUNTERSIGN_WORKERS=1
# The least time a claimed job is protected. The lease actually used is never shorter
# than the slowest document: tiers x tries x COUNTERSIGN_MODEL_TIMEOUT_S, plus a margin.
# COUNTERSIGN_JOB_LEASE_S=300
# COUNTERSIGN_JOB_MAX_ATTEMPTS=3

# --- API -------------------------------------------------------------------------
# Format: name:role:key, comma separated. Roles: operator, reviewer. A value that does
# not parse entirely stops the application at start-up.
# COUNTERSIGN_API_KEYS=ann:reviewer:change-me,intake:operator:change-me-too
# Without keys the API is open, and `serve` then refuses any address but the loopback.
# Only when something else decides who can reach the port (a container whose port is
# published on 127.0.0.1, a reverse proxy that authenticates):
# COUNTERSIGN_ALLOW_OPEN=true

# --- Telemetry -------------------------------------------------------------------
# Needs the "otlp" extra: uv sync --extra otlp
# COUNTERSIGN_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# COUNTERSIGN_LOG_LEVEL=INFO
